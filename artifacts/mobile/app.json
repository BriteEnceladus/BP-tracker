{
  "expo": {
    "name": "BP Tracker",
    "slug": "bp-tracker",
    "version": "1.0.0",
    "description": "A secure, standalone blood pressure and heart rate tracking app with local storage, charts, history, and CSV export. Built with Expo for privacy-focused wellness tracking.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bptracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/images/splash-icon-dark.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.briteenceladus.bptracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock BP Tracker with Face ID for convenience. Your master password remains the root of trust."
      }
    },
    "android": {
      "package": "com.briteenceladus.bptracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "BP Tracker",
      "shortName": "BPTrack",
      "themeColor": "#1E7ADB",
      "backgroundColor": "#0F172A",
      "description": "Log and monitor your blood pressure and heart rate",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BP Tracker to use Face ID for convenient unlock. Your master password is still required for full security."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
