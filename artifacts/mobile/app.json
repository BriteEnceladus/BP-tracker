{
  "expo": {
    "name": "BP Tracker",
    "slug": "bp-tracker",
    "version": "1.1.1",
    "description": "A secure, standalone blood pressure and heart rate tracking app with local storage, charts, history, and CSV export. Built with Expo for privacy-focused wellness tracking.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bptracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/images/splash-icon-dark.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.briteenceladus.bptracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock BP Tracker with Face ID for convenience. Your master password remains the root of trust."
      }
    },
    "android": {
      "package": "com.briteenceladus.bptracker",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "BP Tracker",
      "shortName": "BPTrack",
      "themeColor": "#1E7ADB",
      "backgroundColor": "#0F172A",
      "description": "Log and monitor your blood pressure and heart rate",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BP Tracker to use Face ID for convenient unlock. Your master password is still required for full security."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LatestReading",
              "label": "BP Tracker",
              "description": "Latest blood pressure. Numbers only if you opt in; clears when the app locks.",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/latest-reading.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appName": "BP Tracker",
      "version": "1.1.1",
      "eas": {
        "projectId": "01be2be0-2ae4-4bee-9974-3620e64ef682"
      }
    },
    "owner": "frostenceladus"
  }
}
