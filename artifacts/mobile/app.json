{
  "expo": {
    "name": "BP Tracker",
    "slug": "bp-tracker",
    "owner": "briteenceladus",
    "version": "1.3.0",
    "description": "Mobile-first blood pressure and heart rate tracker. On-device storage, Puter cloud backup, charts, history, and CSV export.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bptracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.briteenceladus.bptracker",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock BP Tracker with Face ID for convenience. Your master password remains the root of trust.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Optional photo attachments are not required for core BP tracking.",
        "NSPhotoLibraryUsageDescription": "Optional photo attachments are not required for core BP tracking.",
        "NSLocationWhenInUseUsageDescription": "Location is optional and not required for blood pressure tracking."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.briteenceladus.bptracker",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ],
      "allowBackup": true
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "BP Tracker",
      "shortName": "BPTrack",
      "themeColor": "#1E7ADB",
      "backgroundColor": "#0F172A",
      "description": "Log and monitor your blood pressure and heart rate",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow BP Tracker to use Face ID for convenient unlock. Your master password is still required for full security."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "appName": "BP Tracker",
      "version": "1.0.0",
      "grokApiBase": "https://api.x.ai/v1",
      "router": {},
      "eas": {
        "projectId": "0fdb4d17-a957-4a48-8e29-ffed84900f0d"
      }
    }
  }
}
