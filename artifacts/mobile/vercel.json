{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "github": {
    "enabled": false
  },
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
